	public VolunteerListResponse searchEmployees(VolunteerManagementFilter volunteerFilter, int pageNumber,
			int pageSize) {
		LOGGER.info("Inside VolunteerManagementServiceImpl class searchEmployees() method start");

		if (volunteerFilter.getSeveranceStatus() != null) {
			List<String> status = new ArrayList<>();
			volunteerFilter.getSeveranceStatus().forEach(v -> {
				switch (v) {
				case AssociateBusinessCaseConstant.VOLUNTEER_STATUS_CODE_V:
					status.add(AssociateBusinessCaseConstant.VOLUNTEER_STATUS_V);
					break;
				case AssociateBusinessCaseConstant.VOLUNTEER_STATUS_CODE_O:
					status.add(AssociateBusinessCaseConstant.VOLUNTEER_STATUS_O);
					break;
				case AssociateBusinessCaseConstant.VOLUNTEER_STATUS_CODE_VA:
					status.add(AssociateBusinessCaseConstant.VOLUNTEER_STATUS_VA);
					break;
				case AssociateBusinessCaseConstant.VOLUNTEER_STATUS_CODE_VD:
					status.add(AssociateBusinessCaseConstant.VOLUNTEER_STATUS_VD);
					break;
				default:
					break;
				}
			});
			volunteerFilter.getSeveranceStatus().clear();
			volunteerFilter.setSeveranceStatus(status);
		}

		List<VolunteerList> volunteerList = new ArrayList<>();
		/*
		 * get all BCs
		 */
		LOGGER.info("Inside VolunteerManagementServiceImpl class searchEmployees() getting all BCs");

		/*
		 * Need to delete after parent changes moved
		 * 
		 * List<BusinessCaseEntity> bcEntityList = associateBcRepository
		 * .findAll(volunteerManagementSpecification.getVolunteerBcFilter(
		 * volunteerFilter));
		 * 
		 * LOGGER.info(
		 * "Inside VolunteerManagementServiceImpl class searchEmployees() getting child BC which is not added to parent"
		 * ); List<ChildParentEntity> notInParent = new ArrayList<>();
		 * bcEntityList.forEach(e -> { notInParent.addAll(e.getChildParentList()); });
		 * List<Long> bcId = new ArrayList<>(); notInParent.forEach(p -> { if
		 * (p.getParentStatus().equalsIgnoreCase("Active")) {
		 * bcId.add(p.getBusinessCaseEntity().getBusinessCaseNumber()); } });
		 * volunteerFilter.setBcNumber(bcId.stream().distinct().collect(Collectors.
		 * toList())); List<BusinessCaseEntity> childBcEntityList =
		 * associateBcRepository
		 * .findAll(volunteerManagementSpecification.getVolunteerBcFilter(
		 * volunteerFilter));
		 */

		// get parent BC numbers based on filter criteria
		List<Long> bcId = new ArrayList<>();
		List<Long> bcIdParent = new ArrayList<>();

		List<ParentBusinessCaseEntity> parentBcEntityLists = parentBusinessCaseRepository
				.findAll(volunteerManagementSpecification.getVolunteerParentBcFilter(volunteerFilter));
		volunteerFilter.setParentBusinessCaseNumber(parentBcEntityLists.stream()
				.map(ParentBusinessCaseEntity::getParentBusinessCaseNumber).collect(Collectors.toList()));
		if (CollectionUtils.isNotEmpty(volunteerFilter.getParentBusinessCaseNumber())) {
			List<BusinessCaseEntity> bcEntityListforParent = associateBcRepository
					.findAll(volunteerManagementSpecification.getVolunteerEmployeeFilterForParent(volunteerFilter));

			List<ChildParentEntity> InParent = new ArrayList<>();
			bcEntityListforParent.forEach(e -> {
				InParent.addAll(e.getChildParentList());
			});
			InParent.forEach(p -> {
				if (p.getParentStatus().equalsIgnoreCase("Active")) {
					bcId.add(p.getBusinessCaseEntity().getBusinessCaseNumber());
					bcIdParent.add(p.getBusinessCaseEntity().getBusinessCaseNumber());
				}
			});
		}

		/*
		 * get all BCs
		 */
		LOGGER.info(
				"Inside VolunteerManagementServiceImpl class  searchEmployees() gettingmethod get all BCs from associateBcRepository");
		List<BusinessCaseEntity> bcEntityList = associateBcRepository
				.findAll(volunteerManagementSpecification.getVolunteerEmployeeFilter(volunteerFilter));

		/*
		 * get child BC which is not added to parent
		 */
		LOGGER.info(
				"Inside VolunteerManagementServiceImpl class searchEmployees() getting child BC which is not added to parent");
		List<ChildParentEntity> notInParent = new ArrayList<>();
		bcEntityList.forEach(e -> {
			notInParent.addAll(e.getChildParentList());
		});
		notInParent.forEach(p -> {
			if (p.getParentStatus().equalsIgnoreCase("Active")) {
				bcId.add(p.getBusinessCaseEntity().getBusinessCaseNumber());
			}
		});
		volunteerFilter.setBcNumber(bcId.stream().distinct().collect(Collectors.toList()));
		List<BusinessCaseEntity> childBcEntityList = associateBcRepository
				.findAll(volunteerManagementSpecification.getVolunteerEmployeeFilter(volunteerFilter));

		/*
		 * get parent Bc
		 */
		LOGGER.info("Inside VolunteerManagementServiceImpl class searchEmployees() getting parent Bc");
		List<ParentBusinessCaseEntity> parentBcEntityList = new ArrayList<>();
		List<ChildParentEntity> childParentEntityList = new ArrayList<>();
		if (CollectionUtils.isNotEmpty(bcIdParent)) {
			List<Long> parentId = associateBcRepository.getParentBc(volunteerFilter.getBusinessCaseNumber());
			childParentEntityList = childParentRepository
					.findAll(volunteerManagementSpecification.getChildParentFilter(bcIdParent, parentId));
			childParentEntityList.forEach(cp -> {
				if (cp.getParentStatus().equalsIgnoreCase("Active")) {
					parentBcEntityList.add(cp.getParentBusinessCaseEntity());
				}
				if (cp.getBusinessCaseEntity().getStatus().equalsIgnoreCase("Active")
						&& !cp.getParentStatus().equalsIgnoreCase("Active") && !volunteerFilter.getBcNumber()
								.contains(cp.getBusinessCaseEntity().getBusinessCaseNumber())) {
					childBcEntityList.add(cp.getBusinessCaseEntity());
				}
			});
		}

		List<Long> universeCount = new ArrayList<>();
		List<Long> surplusCount = new ArrayList<>();
		/*
		 * Set volunteer List for Active child BC which was not added to Active Parent
		 * BC
		 */
		LOGGER.info(
				"Inside VolunteerManagementServiceImpl class searchEmployees()Set volunteer List for Active child BC which was not added to Active Parent Bc");
		Set<BusinessCaseEntity> childBcEntityListRs = childBcEntityList.stream().distinct().collect(Collectors.toSet());
		childBcEntityListRs.forEach(child -> {
			Set<BcEmployeeEntity> bcEmplList = new HashSet<>();
			universeCount.add(child.getUniverse());
			surplusCount.add(Long.parseLong(child.getSurplusCount()));

			if (volunteerFilter.getSeveranceStatus() != null
					&& CollectionUtils.isNotEmpty(volunteerFilter.getSeveranceStatus())) {
				bcEmplList = child.getBcEmployeeEntityList().parallelStream().filter(
						employee -> volunteerFilter.getSeveranceStatus().contains(employee.getSeveranceStatus()))
						.collect(Collectors.toSet());
			} else {
				bcEmplList = child.getBcEmployeeEntityList().parallelStream().filter(employee -> employee
						.getSeveranceStatus() != null
						&& (employee.getSeveranceStatus().equals(AssociateBusinessCaseConstant.VOLUNTEER_STATUS_V)
								|| employee.getSeveranceStatus()
										.equals(AssociateBusinessCaseConstant.VOLUNTEER_STATUS_VA)
								|| employee.getSeveranceStatus()
										.equals(AssociateBusinessCaseConstant.VOLUNTEER_STATUS_VD)
								|| employee.getSeveranceStatus()
										.equals(AssociateBusinessCaseConstant.VOLUNTEER_STATUS_O)))
						.collect(Collectors.toSet());
			}

			if (!StringUtils.isBlank(volunteerFilter.getEmpIdOrName())) {
				bcEmplList = bcEmplList.parallelStream()
						.filter(employee -> (StringUtils.isEmpty(volunteerFilter.getEmpIdOrName()) ? true
								: StringUtils.containsIgnoreCase(employee.getEnterpriseId(),
										volunteerFilter.getEmpIdOrName())
										|| StringUtils.containsIgnoreCase(
												(employee.getLegalLastName() + ", " + employee.getLegalFirstName()),
												volunteerFilter.getEmpIdOrName())))
						.collect(Collectors.toSet());
			}

			// union filter added -- need to optimize code later

			if (volunteerFilter.getUnion() != null && CollectionUtils.isNotEmpty(volunteerFilter.getUnion())) {
				bcEmplList = bcEmplList.parallelStream()
						.filter(employee -> volunteerFilter.getUnion().contains(employee.getUnionLocal()))
						.collect(Collectors.toSet());
			}
			// end

			Set<String> eidList = child.getBcEmployeeEntityList().stream().map(BcEmployeeEntity::getEnterpriseId)
					.collect(Collectors.toSet());
			List<EmployeeSummaryEntity> emplDetails = getEmployeeDetails(eidList);
			Map<String, EmployeeSummaryEntity> groupAllBcByEid = new HashMap<>();
			emplDetails.forEach(e -> {
				groupAllBcByEid.put(e.getEnterpriseId(), e);
			});
			bcEmplList.forEach(empl -> {
				EmployeeSummaryEntity empldetail = groupAllBcByEid.get(empl.getEnterpriseId());
				if (empldetail != null) {
					volunteerList.add(VolunteerList.builder().enterpriseId(empl.getEnterpriseId())
							.employeeName(empldetail.getEmployeeName()).firstName(empldetail.getFirstName())
							.lastName(empldetail.getLastName())
							.seniorityDate(LocalDateTime.parse(empldetail.getSeniorityDate()))
							.continuousServiceDate(LocalDateTime.parse(empldetail.getContinuousServiceDate()))
							.businessCaseNo(empl.getBusinessCaseEntity() == null ? null
									: empl.getBusinessCaseEntity().getBusinessCaseNumber())
							.planCode(empl.getBusinessCaseEntity().getPlanCodeEntity().getPlanCode())
							.businessCaseNoPc(empl.getBusinessCaseEntity().getPsBusinessCaseNumber())
							.universe(child.getUniverse()).surplus(Long.parseLong(child.getSurplusCount()))
							.businessCaseNo(empl.getBusinessCaseEntity().getBusinessCaseNumber()).isParent(false)
							.bcStatus(empl.getBusinessCaseEntity().getStatus())
							.CBA(empl.getCollectiveAgreementDescription()).union(empl.getUnionLocal())
							.day1SeveranceStatus(empl.getDay1SeveranceStatus()).statusCode(empl.getSeveranceStatus())
							.volNotificationStatusSent(empl.getVolNotificationStatus())
							.volNotificationTimestamp(empl.getVolNotificationDate()).build());
				}
			});

		});

		LOGGER.info("Inside VolunteerManagementServiceImpl class searchVolunteerBc() method Grouping by parent BC");
		if (CollectionUtils.isNotEmpty(parentBcEntityList)) {
			Map<ParentBusinessCaseEntity, List<BusinessCaseEntity>> groupByBcEntity = childParentEntityList.stream()
					.collect(Collectors.groupingBy(ChildParentEntity::getParentBusinessCaseEntity,
							Collectors.mapping(ChildParentEntity::getBusinessCaseEntity, Collectors.toList())));

			/*
			 * Set volunteer List for Active Parent BC
			 */
			LOGGER.info(
					"Inside VolunteerManagementServiceImpl class searchEmployees()Set volunteer List for Active Parent BC");
			Set<ParentBusinessCaseEntity> parentBcEntityListRs = parentBcEntityList.stream().distinct()
					.collect(Collectors.toSet());
			parentBcEntityListRs.forEach(p -> {
				List<BusinessCaseEntity> childBcs = groupByBcEntity.get(p);
				universeCount.add(parentBusinessCaseRepository.getUniverseCount(p.getParentId()));
				List<String> surplusList = childBcs.stream().map(BusinessCaseEntity::getSurplusCount)
						.collect(Collectors.toList());
				Long surplus = (long) 0;
				for (String s : surplusList) {
					if(!StringUtils.isBlank(s))
					surplus += Long.parseLong(s);
				}
				if (p.getSurplusCount() == null) {
					surplusCount.add(surplus);
				} else {
					surplusCount.add(Long.parseLong(p.getSurplusCount()));
				}
				// get child bc added to parent
				LOGGER.info(
						"Inside VolunteerManagementServiceImpl class searchEmployees() get child bc added to parent");
				Set<BusinessCaseEntity> bcList = new HashSet<>();
				p.getChildParentList().forEach(cp -> {
					bcList.add(cp.getBusinessCaseEntity());
				});
				/*
				 * directly added employees
				 */
				LOGGER.info("Inside VolunteerManagementServiceImpl class searchEmployees() directly added employees");
				Set<BcEmployeeEntity> bcEmplList = new HashSet<>();
				// filter applied
				LOGGER.info("Inside VolunteerManagementServiceImpl class searchEmployees() filter applied");

				if (volunteerFilter.getSeveranceStatus() != null
						&& CollectionUtils.isNotEmpty(volunteerFilter.getSeveranceStatus())) {
					bcEmplList = p.getBcEmployeeEntityList().parallelStream().filter(
							employee -> volunteerFilter.getSeveranceStatus().contains(employee.getSeveranceStatus()))
							.collect(Collectors.toSet());
				} else {
					bcEmplList = p.getBcEmployeeEntityList().parallelStream().filter(employee -> employee
							.getSeveranceStatus() != null
							&& (employee.getSeveranceStatus().equals(AssociateBusinessCaseConstant.VOLUNTEER_STATUS_V)
									|| employee.getSeveranceStatus()
											.equals(AssociateBusinessCaseConstant.VOLUNTEER_STATUS_VA)
									|| employee.getSeveranceStatus()
											.equals(AssociateBusinessCaseConstant.VOLUNTEER_STATUS_VD)
									|| employee.getSeveranceStatus()
											.equals(AssociateBusinessCaseConstant.VOLUNTEER_STATUS_O)))
							.collect(Collectors.toSet());
				}
				for (BusinessCaseEntity bc : bcList) {
					if (volunteerFilter.getSeveranceStatus() != null
							&& CollectionUtils.isNotEmpty(volunteerFilter.getSeveranceStatus())) {
						bcEmplList.addAll(bc
								.getBcEmployeeEntityList().parallelStream().filter(employee -> volunteerFilter
										.getSeveranceStatus().contains(employee.getSeveranceStatus()))
								.collect(Collectors.toSet()));
					} else {
						bcEmplList.addAll(bc.getBcEmployeeEntityList().parallelStream()
								.filter(employee -> employee.getSeveranceStatus() != null && (employee
										.getSeveranceStatus().equals(AssociateBusinessCaseConstant.VOLUNTEER_STATUS_V)
										|| employee.getSeveranceStatus()
												.equals(AssociateBusinessCaseConstant.VOLUNTEER_STATUS_VA)
										|| employee.getSeveranceStatus()
												.equals(AssociateBusinessCaseConstant.VOLUNTEER_STATUS_VD)
										|| employee.getSeveranceStatus()
												.equals(AssociateBusinessCaseConstant.VOLUNTEER_STATUS_O)))
								.collect(Collectors.toSet()));
					}

					if (!StringUtils.isBlank(volunteerFilter.getEmpIdOrName())) {
						bcEmplList = bcEmplList.parallelStream()
								.filter(employee -> (StringUtils.isEmpty(volunteerFilter.getEmpIdOrName()) ? true
										: StringUtils.containsIgnoreCase(employee.getEnterpriseId(),
												volunteerFilter.getEmpIdOrName())
												|| StringUtils.containsIgnoreCase(
														(employee.getLegalLastName() + ", "
																+ employee.getLegalFirstName()),
														volunteerFilter.getEmpIdOrName())))
								.collect(Collectors.toSet());
					}

					// union filter added -- need to optimize code later

					if (volunteerFilter.getUnion() != null && CollectionUtils.isNotEmpty(volunteerFilter.getUnion())) {
						bcEmplList = bcEmplList.parallelStream()
								.filter(employee -> volunteerFilter.getUnion().contains(employee.getUnionLocal()))
								.collect(Collectors.toSet());
					}
					// end

					Set<String> eidList = bcEmplList.stream().map(BcEmployeeEntity::getEnterpriseId)
							.collect(Collectors.toSet());
					List<EmployeeSummaryEntity> emplDetails = getEmployeeDetails(eidList);
					Map<String, EmployeeSummaryEntity> groupAllBcByEid = new HashMap<>();
					emplDetails.forEach(e -> {
						groupAllBcByEid.put(e.getEnterpriseId(), e);
					});
					bcEmplList.forEach(empl -> {
						EmployeeSummaryEntity empldetail = groupAllBcByEid.get(empl.getEnterpriseId());
						if (empldetail != null) {
							volunteerList.add(VolunteerList.builder().enterpriseId(empl.getEnterpriseId())
									.employeeName(empldetail.getEmployeeName()).firstName(empldetail.getFirstName())
									.lastName(empldetail.getLastName())
									.seniorityDate(LocalDateTime.parse(empldetail.getSeniorityDate()))
									.continuousServiceDate(LocalDateTime.parse(empldetail.getContinuousServiceDate()))
									.businessCaseNoPc(p.getParentBusinessCaseNumber())
									.planCode(p.getPlanCodeEntity().getPlanCode()).bcStatus(p.getStatus())
									.businessCaseNo(p.getParentId()).isParent(true)
									.universe(parentBusinessCaseRepository.getUniverseCount(p.getParentId()))
									.surplus(p.getSurplusCount() == null ? 0 : Long.parseLong(p.getSurplusCount()))
									.childBusinessCaseNo(empl.getBusinessCaseEntity() == null ? null
											: empl.getBusinessCaseEntity().getBusinessCaseNumber())
									.CBA(empl.getCollectiveAgreementDescription()).union(empl.getUnionLocal())
									.statusCode(empl.getSeveranceStatus())
									.volNotificationStatusSent(empl.getVolNotificationStatus())
									.volNotificationTimestamp(empl.getVolNotificationDate()).build());
						}
					});
				}

			});
		}

		/*
		 * set filter details
		 */
		LOGGER.info("Inside VolunteerManagementServiceImpl class searchEmployees() set filter details");
		List<String> unionList = volunteerList.parallelStream()
				.filter(employee -> !StringUtils.isEmpty(employee.getUnion()))
				.sorted(Comparator.comparing(VolunteerList::getUnion)).map(VolunteerList::getUnion).distinct()
				.collect(Collectors.toList());
		List<String> cbaList = volunteerList.parallelStream()
				.filter(employee -> !StringUtils.isEmpty(employee.getCBA()))
				.sorted(Comparator.comparing(VolunteerList::getCBA)).map(VolunteerList::getCBA).distinct()
				.collect(Collectors.toList());
		/*
		 * Pagination details
		 */
		List<VolunteerList> response = volunteerList.stream().distinct().collect(Collectors.toList());
		Pageable pageable = PageRequest.of(pageNumber - 1, pageSize);
		int start = (int) pageable.getOffset();
		int end = Math.min((start + pageable.getPageSize()), response.size());
		if (StringUtils.equals(volunteerFilter.getSort(), "businessCaseNoPc")) {
			Comparator<VolunteerList> defaultCompare = Comparator.comparing(VolunteerList::getPlanCode)
					.thenComparing(VolunteerList::getBusinessCaseNo).thenComparing(VolunteerList::getSeniorityDate);
			response.sort(defaultCompare);
		}
		// IVD-85917 Default sorting on seniority date was having inconsistent sorting
		// due to same date so adding second comparison point
		else if (StringUtils.equals(volunteerFilter.getSort(), "continuousServiceDate")) {
			Comparator<VolunteerList> defaultCompare = Comparator.comparing(VolunteerList::getContinuousServiceDate)
					.thenComparing(VolunteerList::getEnterpriseId).thenComparing(VolunteerList::getBusinessCaseNo);
			response.sort(defaultCompare);
		} else
			response.sort(sortingVolunteerOptions.get(volunteerFilter.getSort()));
		if ("desc".equals(volunteerFilter.getOrder()))
			Collections.reverse(response);

		Page<VolunteerList> volunteerListRs = new PageImpl<>(response.subList(start, end), pageable, response.size());
		List<String> bcList = response.stream().filter(employee -> !StringUtils.isEmpty(employee.getBusinessCaseNoPc()))
				.sorted(Comparator.comparing(VolunteerList::getPlanCode)
						.thenComparing(VolunteerList::getBusinessCaseNo))
				.map(VolunteerList::getBusinessCaseNoPc).distinct().collect(Collectors.toList());
		long volunteerCount = response.stream()
				.filter(employee -> employee.getStatusCode().equals(AssociateBusinessCaseConstant.VOLUNTEER_STATUS_V)
						|| employee.getStatusCode().equals(AssociateBusinessCaseConstant.VOLUNTEER_STATUS_VA)
						|| employee.getStatusCode().equals(AssociateBusinessCaseConstant.VOLUNTEER_STATUS_VD))
				.count();
		long overSubcribedCount = response.stream()
				.filter(employee -> employee.getStatusCode() != null
						&& employee.getStatusCode().equalsIgnoreCase(AssociateBusinessCaseConstant.VOLUNTEER_STATUS_O))
				.count();
		/*
		 * set status for UI
		 */
		LOGGER.info("Inside VolunteerManagementServiceImpl class searchEmployees() set status for UI");
		response.forEach(v -> {
			switch (v.getStatusCode()) {
			case AssociateBusinessCaseConstant.VOLUNTEER_STATUS_V:
				v.setStatusCode(AssociateBusinessCaseConstant.VOLUNTEER_STATUS_CODE_V);
				break;
			case AssociateBusinessCaseConstant.VOLUNTEER_STATUS_O:
				v.setStatusCode(AssociateBusinessCaseConstant.VOLUNTEER_STATUS_CODE_O);
				break;
			case AssociateBusinessCaseConstant.VOLUNTEER_STATUS_VA:
				v.setStatusCode(AssociateBusinessCaseConstant.VOLUNTEER_STATUS_CODE_VA);
				break;
			case AssociateBusinessCaseConstant.VOLUNTEER_STATUS_VD:
				v.setStatusCode(AssociateBusinessCaseConstant.VOLUNTEER_STATUS_CODE_VD);
				break;
			default:
				break;
			}
		});
		Set<String> severanceStatusList = response.stream()
				.filter(employee -> !StringUtils.isEmpty(employee.getStatusCode())).map(VolunteerList::getStatusCode)
				.collect(Collectors.toSet());
//		if (CollectionUtils.isNotEmpty(response)) {
		/*
		 * set universe and surplus count
		 */
//			Map<String, Long> universe = new HashMap<>();
//			response.forEach(r -> universe.put(r.getBusinessCaseNoPc(), r.getUniverse()));
//			bcList.forEach(u -> universeCount.add(universe.get(u)));
//			Map<String, Long> surplus = new HashMap<>();
//			response.forEach(r -> surplus.put(r.getBusinessCaseNoPc(), r.getSurplus()));
//			bcList.forEach(u -> surplusCount.add(surplus.get(u)));
//		}
		LOGGER.info("Inside VolunteerManagementServiceImpl class searchEmployees() method end");
		return VolunteerListResponse.builder().volunteerList(volunteerListRs.getContent()).cbaList(cbaList)
				.bcList(bcList).unionList(unionList).severanceStatusList(severanceStatusList)
				.volunteerCount(volunteerCount).overSubscribe(overSubcribedCount)
				.universe(universeCount.stream().mapToLong(Long::intValue).sum())
				.surPlus(surplusCount.stream().mapToLong(Long::longValue).sum())
				.numberOfElements(volunteerListRs.getNumberOfElements())
				.currentPageNumber(volunteerListRs.getPageable().getPageNumber() + 1)
				.totalElements(volunteerListRs.getTotalElements()).pageSize(volunteerListRs.getPageable().getPageSize())
				.totalPages(volunteerListRs.getTotalPages()).build();
	}

	private List<EmployeeSummaryEntity> getEmployeeDetails(Set<String> enterpriseIdList) {

		LOGGER.info("Inside VolunteerManagementServiceImpl class getEmployeeDetails() method start");
		HttpEntity<MultiValueMap<String, String>> request = getRequest();

		StringBuilder eidList = new StringBuilder();

		enterpriseIdList.stream().forEach(eid -> {
			if (eidList.length() > 0) {
				eidList.append(",");
			}
			eidList.append(eid);
		});

		String requestURL = hcmURL + ManagementBusinessCaseConstant.WD_EMPLOYEE_SUMMARY_VW_ENTERPRISE_ID_IN + eidList
				+ ManagementBusinessCaseConstant.CLOSING_BRACKET + "&order=seniority_date.asc.nullslast";

		ResponseEntity<String> responseEntity = proxyRestTemplate.exchange(requestURL, HttpMethod.GET, request,
				String.class);
		Gson gson = new Gson();

		EmployeeSummaryEntity[] response = gson.fromJson(responseEntity.getBody(), EmployeeSummaryEntity[].class);

		LOGGER.info("Inside VolunteerManagementServiceImpl class getEmployeeDetails() method end");
		return Arrays.asList(response);
	}

	private HttpEntity<MultiValueMap<String, String>> getRequest() {

		LOGGER.info("Inside VolunteerManagementServiceImpl class getRequest() method start");
		HttpHeaders rheaders = new HttpHeaders();
		rheaders.setContentType(MediaType.APPLICATION_JSON);

		List<MediaType> acceptableMediaTypes = new ArrayList<MediaType>();
		acceptableMediaTypes.add(new MediaType("*"));

		rheaders.setAccept(acceptableMediaTypes);
		rheaders.add("Authorization", "Bearer " + jwtHelper.getJWT());
		rheaders.add("Content-Profile", "public");

		MultiValueMap<String, String> body = new LinkedMultiValueMap<>();

		HttpEntity<MultiValueMap<String, String>> request = new HttpEntity<>(body, rheaders);
		LOGGER.info("Inside VolunteerManagementServiceImpl class getRequest() method end");
		return request;
	}

	private List<BusinessCaseEntity> findBcBasedOnRole(String role, String loggedInUser,
			VolunteerManagementFilter volunteerListFilter) {
		LOGGER.info("Inside VolunteerManagementServiceImpl class findBcBasedOnRole() method start");
		Filters filters = Filters.builder().build();
		filters.setIsStatistics(false);
		filters.setRole(role);
		filters.setLoggedInUser(loggedInUser);
		filters.setStatusList(Arrays.asList("Active"));

		if (volunteerListFilter != null) {
			if (volunteerListFilter.getStartDateOfVolunteerPeriod() != null) {
				filters.setStartDateOfVolunteerPeriodDate(
						volunteerListFilter.getStartDateOfVolunteerPeriod().toLocalDate());
			}
			if (volunteerListFilter.getEndDateOfVolunteerPeriod() != null) {
				filters.setEndDateOfVolunteerPeriodDate(
						volunteerListFilter.getEndDateOfVolunteerPeriod().toLocalDate());
			}
			if (!StringUtils.isEmpty(volunteerListFilter.getPlanCode())) {
				filters.setPlanCode(volunteerListFilter.getPlanCode());
			}
			if (!CollectionUtils.isEmpty(volunteerListFilter.getBusinessCaseNumber())) {
				filters.setBusinessCaseNoList(volunteerListFilter.getBusinessCaseNumber());
			}
			if (!CollectionUtils.isEmpty(volunteerListFilter.getCba())) {
				filters.setCbaList(volunteerListFilter.getCba());
			}

			if (!CollectionUtils.isEmpty(volunteerListFilter.getUnion())) {
				filters.setUnionList(volunteerListFilter.getUnion());
			}

		}
		LOGGER.info("Inside VolunteerManagementServiceImpl class findBcBasedOnRole() method end");

		return repo.filters(filters);
	}

