				.findAll(volunteerManagementSpecification.getVolunteerParentBcFilter(volunteerFilter));
		volunteerFilter.setParentBusinessCaseNumber(parentBcEntityLists.stream()
				.map(ParentBusinessCaseEntity::getParentBusinessCaseNumber).collect(Collectors.toList()));
		if (CollectionUtils.isNotEmpty(volunteerFilter.getParentBusinessCaseNumber())) {
			List<BusinessCaseEntity> bcEntityListforParent = associateBcRepository
					.findAll(volunteerManagementSpecification.getVolunteerEmployeeFilterForParent(volunteerFilter));

			List<ChildParentEntity> InParent = new ArrayList<>();
			bcEntityListforParent.forEach(e -> {
				InParent.addAll(e.getChildParentList());
			});
			InParent.forEach(p -> {
				if (p.getParentStatus().equalsIgnoreCase("Active")) {
					bcId.add(p.getBusinessCaseEntity().getBusinessCaseNumber());
					bcIdParent.add(p.getBusinessCaseEntity().getBusinessCaseNumber());
				}
			});
		}

		/*
		 * get all BCs
		 */
		LOGGER.info(
				"Inside VolunteerManagementServiceImpl class  searchEmployees() gettingmethod get all BCs from associateBcRepository");
		List<BusinessCaseEntity> bcEntityList = associateBcRepository
				.findAll(volunteerManagementSpecification.getVolunteerEmployeeFilter(volunteerFilter));

		/*
		 * get child BC which is not added to parent
		 */
		LOGGER.info(
				"Inside VolunteerManagementServiceImpl class searchEmployees() getting child BC which is not added to parent");
		List<ChildParentEntity> notInParent = new ArrayList<>();
		bcEntityList.forEach(e -> {
			notInParent.addAll(e.getChildParentList());
		});
		notInParent.forEach(p -> {
			if (p.getParentStatus().equalsIgnoreCase("Active")) {
				bcId.add(p.getBusinessCaseEntity().getBusinessCaseNumber());
			}
		});
		volunteerFilter.setBcNumber(bcId.stream().distinct().collect(Collectors.toList()));
		List<BusinessCaseEntity> childBcEntityList = associateBcRepository
				.findAll(volunteerManagementSpecification.getVolunteerEmployeeFilter(volunteerFilter));

		/*
		 * get parent Bc
		 */
		LOGGER.info("Inside VolunteerManagementServiceImpl class searchEmployees() getting parent Bc");
		List<ParentBusinessCaseEntity> parentBcEntityList = new ArrayList<>();
		List<ChildParentEntity> childParentEntityList = new ArrayList<>();
		if (CollectionUtils.isNotEmpty(bcIdParent)) {
			List<Long> parentId = associateBcRepository.getParentBc(volunteerFilter.getBusinessCaseNumber());
			childParentEntityList = childParentRepository
					.findAll(volunteerManagementSpecification.getChildParentFilter(bcIdParent, parentId));
			childParentEntityList.forEach(cp -> {
				if (cp.getParentStatus().equalsIgnoreCase("Active")) {
					parentBcEntityList.add(cp.getParentBusinessCaseEntity());
				}
				if (cp.getBusinessCaseEntity().getStatus().equalsIgnoreCase("Active")
						&& !cp.getParentStatus().equalsIgnoreCase("Active") && !volunteerFilter.getBcNumber()
								.contains(cp.getBusinessCaseEntity().getBusinessCaseNumber())) {
					childBcEntityList.add(cp.getBusinessCaseEntity());
				}
			});
		}

		/*
		 * Set volunteer List for Active child BC which was not added to Active Parent
		 * BC
		 */
		LOGGER.info(
				"Inside VolunteerManagementServiceImpl class searchEmployees()Set volunteer List for Active child BC which was not added to Active Parent Bc");
		Set<BusinessCaseEntity> childBcEntityListRs = childBcEntityList.stream().distinct().collect(Collectors.toSet());
		childBcEntityListRs.forEach(child -> {
			Set<BcEmployeeEntity> bcEmplList = new HashSet<>();

			if (volunteerFilter.getSeveranceStatus() != null
					&& CollectionUtils.isNotEmpty(volunteerFilter.getSeveranceStatus())) {
				bcEmplList = child.getBcEmployeeEntityList().parallelStream().filter(
						employee -> volunteerFilter.getSeveranceStatus().contains(employee.getSeveranceStatus()))
						.collect(Collectors.toSet());
			} else {
				bcEmplList = child.getBcEmployeeEntityList().parallelStream().filter(employee -> employee
						.getSeveranceStatus() != null
						&& (employee.getSeveranceStatus().equals(AssociateBusinessCaseConstant.VOLUNTEER_STATUS_V)
								|| employee.getSeveranceStatus()
										.equals(AssociateBusinessCaseConstant.VOLUNTEER_STATUS_VA)
								|| employee.getSeveranceStatus()
										.equals(AssociateBusinessCaseConstant.VOLUNTEER_STATUS_VD)
								|| employee.getSeveranceStatus()
										.equals(AssociateBusinessCaseConstant.VOLUNTEER_STATUS_O)
								|| employee.getSeveranceStatus()
										.equals(AssociateBusinessCaseConstant.VOLUNTEER_STATUS_OA)
								|| employee.getSeveranceStatus()
										.equals(AssociateBusinessCaseConstant.VOLUNTEER_STATUS_OD)))
						.collect(Collectors.toSet());
			}

			if (!StringUtils.isBlank(volunteerFilter.getEmpIdOrName())) {
				bcEmplList = bcEmplList.parallelStream()
						.filter(employee -> (StringUtils.isEmpty(volunteerFilter.getEmpIdOrName()) ? true
								: StringUtils.containsIgnoreCase(employee.getEnterpriseId(),
										volunteerFilter.getEmpIdOrName())
										|| StringUtils.containsIgnoreCase(
												(employee.getLegalLastName() + ", " + employee.getLegalFirstName()),
												volunteerFilter.getEmpIdOrName())))
						.collect(Collectors.toSet());
			}

			// union filter added -- need to optimize code later

			if (volunteerFilter.getUnion() != null && CollectionUtils.isNotEmpty(volunteerFilter.getUnion())) {
				bcEmplList = bcEmplList.parallelStream()
						.filter(employee -> volunteerFilter.getUnion().contains(employee.getUnionLocal()))
						.collect(Collectors.toSet());
			}
			if (volunteerFilter.getCba() != null && CollectionUtils.isNotEmpty(volunteerFilter.getCba())) {
				bcEmplList = bcEmplList.parallelStream()
						.filter(employee -> volunteerFilter.getCba().contains(employee.getCollectiveAgreementDescription()))
						.collect(Collectors.toSet());
			}
			// end

			bcEmplList.forEach(empl -> {

				volunteerList.add(VolunteerList.builder().enterpriseId(empl.getEnterpriseId())
						.businessCaseNoPc(empl.getBusinessCaseEntity().getPsBusinessCaseNumber()).build());

			});

		});

		LOGGER.info("Inside VolunteerManagementServiceImpl class searchVolunteerBc() method Grouping by parent BC");
		if (CollectionUtils.isNotEmpty(parentBcEntityList)) {
			/*
			 * Set volunteer List for Active Parent BC
			 */
			LOGGER.info(
					"Inside VolunteerManagementServiceImpl class searchEmployees()Set volunteer List for Active Parent BC");
			Set<ParentBusinessCaseEntity> parentBcEntityListRs = parentBcEntityList.stream().distinct()
					.collect(Collectors.toSet());
			parentBcEntityListRs.forEach(p -> {

				// get child bc added to parent
				LOGGER.info(
						"Inside VolunteerManagementServiceImpl class searchEmployees() get child bc added to parent");
				Set<BusinessCaseEntity> bcList = new HashSet<>();
				p.getChildParentList().forEach(cp -> {
					bcList.add(cp.getBusinessCaseEntity());
				});
				/*
				 * directly added employees
				 */
				LOGGER.info("Inside VolunteerManagementServiceImpl class searchEmployees() directly added employees");
				Set<BcEmployeeEntity> bcEmplList = new HashSet<>();
				// filter applied
				LOGGER.info("Inside VolunteerManagementServiceImpl class searchEmployees() filter applied");

				if (volunteerFilter.getSeveranceStatus() != null
						&& CollectionUtils.isNotEmpty(volunteerFilter.getSeveranceStatus())) {
					bcEmplList = p.getBcEmployeeEntityList().parallelStream().filter(
							employee -> volunteerFilter.getSeveranceStatus().contains(employee.getSeveranceStatus()))
							.collect(Collectors.toSet());
				} else {
					bcEmplList = p.getBcEmployeeEntityList().parallelStream().filter(employee -> employee
							.getSeveranceStatus() != null
							&& (employee.getSeveranceStatus().equals(AssociateBusinessCaseConstant.VOLUNTEER_STATUS_V)
									|| employee.getSeveranceStatus()
											.equals(AssociateBusinessCaseConstant.VOLUNTEER_STATUS_VA)
									|| employee.getSeveranceStatus()
											.equals(AssociateBusinessCaseConstant.VOLUNTEER_STATUS_VD)
									|| employee.getSeveranceStatus()
											.equals(AssociateBusinessCaseConstant.VOLUNTEER_STATUS_O)
									|| employee.getSeveranceStatus()
											.equals(AssociateBusinessCaseConstant.VOLUNTEER_STATUS_OA)
									|| employee.getSeveranceStatus()
											.equals(AssociateBusinessCaseConstant.VOLUNTEER_STATUS_OD)))
							.collect(Collectors.toSet());
				}
				for (BusinessCaseEntity bc : bcList) {
					if (volunteerFilter.getSeveranceStatus() != null
							&& CollectionUtils.isNotEmpty(volunteerFilter.getSeveranceStatus())) {
						bcEmplList.addAll(bc
								.getBcEmployeeEntityList().parallelStream().filter(employee -> volunteerFilter
										.getSeveranceStatus().contains(employee.getSeveranceStatus()))
								.collect(Collectors.toSet()));
					} else {
						bcEmplList.addAll(bc.getBcEmployeeEntityList().parallelStream()
								.filter(employee -> employee.getSeveranceStatus() != null && (employee
										.getSeveranceStatus().equals(AssociateBusinessCaseConstant.VOLUNTEER_STATUS_V)
										|| employee.getSeveranceStatus()
												.equals(AssociateBusinessCaseConstant.VOLUNTEER_STATUS_VA)
										|| employee.getSeveranceStatus()
												.equals(AssociateBusinessCaseConstant.VOLUNTEER_STATUS_VD)
										|| employee.getSeveranceStatus()
												.equals(AssociateBusinessCaseConstant.VOLUNTEER_STATUS_O)
										|| employee.getSeveranceStatus()
												.equals(AssociateBusinessCaseConstant.VOLUNTEER_STATUS_OA)
										|| employee.getSeveranceStatus()
												.equals(AssociateBusinessCaseConstant.VOLUNTEER_STATUS_OD)))
								.collect(Collectors.toSet()));
					}

					if (!StringUtils.isBlank(volunteerFilter.getEmpIdOrName())) {
						bcEmplList = bcEmplList.parallelStream()
								.filter(employee -> (StringUtils.isEmpty(volunteerFilter.getEmpIdOrName()) ? true
										: StringUtils.containsIgnoreCase(employee.getEnterpriseId(),
												volunteerFilter.getEmpIdOrName())
												|| StringUtils.containsIgnoreCase(
														(employee.getLegalLastName() + ", "
																+ employee.getLegalFirstName()),
														volunteerFilter.getEmpIdOrName())))
								.collect(Collectors.toSet());
					}

					// union filter added -- need to optimize code later

					if (volunteerFilter.getUnion() != null && CollectionUtils.isNotEmpty(volunteerFilter.getUnion())) {
						bcEmplList = bcEmplList.parallelStream()
								.filter(employee -> volunteerFilter.getUnion().contains(employee.getUnionLocal()))
								.collect(Collectors.toSet());
					}
					if (volunteerFilter.getCba() != null && CollectionUtils.isNotEmpty(volunteerFilter.getCba())) {
						bcEmplList = bcEmplList.parallelStream()
								.filter(employee -> volunteerFilter.getCba().contains(employee.getCollectiveAgreementDescription()))
								.collect(Collectors.toSet());
					}
					// end

					bcEmplList.forEach(empl -> {

						volunteerList.add(VolunteerList.builder().enterpriseId(empl.getEnterpriseId())
								.businessCaseNoPc(p.getParentBusinessCaseNumber()).build());

					});
				}

			});
		}

		List<VolunteerList> response = volunteerList.stream().distinct().collect(Collectors.toList());

		LOGGER.info("Inside VolunteerManagementServiceImpl class searchEmployees() method end");
		return VolunteerListResponse.builder().volunteerList(response).build();
	}

