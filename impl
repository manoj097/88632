    private void sendAndUpdate(List<BcEmployeeEntity> employees, String notificationType,
                               VolunteerNotificationRq volunteerNotificationRq, String loggedInUser, List<String> failedEids) {
        List<String> eids = employees.stream().map(BcEmployeeEntity::getEnterpriseId).collect(Collectors.toList());
        try {
            NotificationRs response = notificationHelper.sendVolunteerNotification(employees, notificationType);
            if (response != null) {
                updateNotificationStatus(employees, volunteerNotificationRq, response, loggedInUser);
            } else {
                LOGGER.error("Email notification returned no response for employees {}", eids);
                failedEids.addAll(eids);
            }
        } catch (Exception ex) {
            LOGGER.error("Email notification failed for employees {}", eids, ex);
            failedEids.addAll(eids);
        }
    }

	private void updateNotificationStatus(List<BcEmployeeEntity> employeeList, VolunteerNotificationRq volunteerNotificationRq,
										  NotificationRs emailResponse, String loggedInUser) {
		if (volunteerNotificationRq.isVolunteerNotification() && emailResponse != null) {
			LOGGER.info("Inside VolunteerManagementServiceImpl class updateNotificationStatus() method Update Notification Status");
			employeeList.forEach(e -> {
				// update only if volunteer is accepted or denied
				if (StringUtils.equalsAnyIgnoreCase(e.getSeveranceStatus(),
						AssociateBusinessCaseConstant.VOLUNTEER_STATUS_VA,
						AssociateBusinessCaseConstant.VOLUNTEER_STATUS_OA,
						AssociateBusinessCaseConstant.VOLUNTEER_STATUS_VD,
						AssociateBusinessCaseConstant.VOLUNTEER_STATUS_OD)) {
					List<EmployeeAuditRequest> employeeAuditList = new ArrayList<>();
					employeeAuditList.add(EmployeeAuditRequest.builder()
							.fieldName(StringUtils.equalsAnyIgnoreCase(e.getSeveranceStatus(),
									AssociateBusinessCaseConstant.VOLUNTEER_STATUS_VA,
									AssociateBusinessCaseConstant.VOLUNTEER_STATUS_OA) ? "Offer Acceptance Sent"
									: "Offer Denial Sent")
							.oldValue(null).newValue("Yes").build());
					employeeAuditList.add(EmployeeAuditRequest.builder()
							.fieldName(StringUtils.equalsAnyIgnoreCase(e.getSeveranceStatus(),
									AssociateBusinessCaseConstant.VOLUNTEER_STATUS_VA,
									AssociateBusinessCaseConstant.VOLUNTEER_STATUS_OA) ? "Offer Acceptance Date"
									: "Offer Denial Date")
							.oldValue(e.getVolNotificationDate() == null ? null
									: e.getVolNotificationDate().toLocalDate().format(auditDateFormat))
							.newValue(LocalDate.now().format(auditDateFormat)).build());
					e.setVolNotificationStatus(true);
					e.setVolNotificationDate(LocalDateTime.now());
					e.setLastModifiedBy(loggedInUser);
					businessCaseAuditHelper.persistEmployeeAudit(loggedInUser, e.getEnterpriseId(),
							e.getBusinessCaseEntity() != null ? e.getBusinessCaseEntity().getPsBusinessCaseNumber()
									: e.getParentBusinessCaseEntity().getParentBusinessCaseNumber(),
							employeeAuditList);
				}
			});
		} else if (emailResponse != null) {
			employeeList.forEach(e -> {
				List<EmployeeAuditRequest> employeeAuditList = new ArrayList<>();
				employeeAuditList.add(EmployeeAuditRequest.builder().fieldName("Offer Notification Sent").oldValue(null)
						.newValue("Yes").build());
				employeeAuditList.add(EmployeeAuditRequest.builder().fieldName("Offer Notification Date")
						.oldValue(e.getOfferNotificationSentDate() == null ? null
								: e.getOfferNotificationSentDate().toLocalDate().format(auditDateFormat))
						.newValue(LocalDate.now().format(auditDateFormat)).build());
				employeeAuditList.add(EmployeeAuditRequest.builder().fieldName("Portal Access").oldValue(null)
						.newValue("Enabled").build());
				e.setIsOfferNotificationSent(true);
				e.setEmployeePortalAccess(true);
				e.setOfferNotificationSentDate(LocalDateTime.now());
				e.setLastModifiedBy(loggedInUser);
				businessCaseAuditHelper.persistEmployeeAudit(loggedInUser, e.getEnterpriseId(),
						e.getBusinessCaseEntity() != null ? e.getBusinessCaseEntity().getPsBusinessCaseNumber()
								: e.getParentBusinessCaseEntity().getParentBusinessCaseNumber(),
						employeeAuditList);
			});
		}
		bcEmployeeRepository.saveAll(employeeList);
	}

	@Override
	public String volunteerEmpl(String bcId, List<String> eids, Boolean isOfferAccepted, String loggedInUser) {
		LOGGER.info("Inside VolunteerManagementServiceImpl class volunteerEmpl() method  start");
		String status = null;
		if (isOfferAccepted.equals(true)) {
			status = "V";
		} else {
			status = "E";
		}
		final String sevStatus = status;
		final String modifiedBy = loggedInUser;
		bcEmployeeRepository.updateStatus(bcId, eids, sevStatus, modifiedBy);
		List<BcEmployeeEntity> employeeList = bcEmployeeRepository.getEmplByBcId(Arrays.asList(bcId));
		if (employeeList.isEmpty()) {
			throw new IllegalArgumentException("Employees are Not found for this BC : " + bcId);
		}
		Long volunteerCount = employeeList.stream()
				.filter(employee -> employee.getSeveranceStatus() != null
						&& !employee.getSeveranceStatus().equals(AssociateBusinessCaseConstant.VOLUNTEER_STATUS_E))
				.count();
		ParentBusinessCaseEntity parentBcEntity = parentBusinessCaseRepository.findByParentBcId(bcId);
		/*
		 * parent BC overSubscribed implementation
		 */
		if (parentBcEntity != null) {
			Long surplusCount = Long.parseLong(parentBcEntity.getSurplusCount());
			if (volunteerCount > surplusCount) {
				Set<String> eidList = employeeList.stream()
						.filter(e -> e.getSeveranceStatus().equals(AssociateBusinessCaseConstant.VOLUNTEER_STATUS_V)
								|| e.getSeveranceStatus().equals(AssociateBusinessCaseConstant.VOLUNTEER_STATUS_O))
						.map(BcEmployeeEntity::getEnterpriseId).collect(Collectors.toSet());
				List<EmployeeSummaryEntity> emplDetails = getEmployeeDetails(eidList);
				List<EmployeeSummaryEntity> overSubscribed = emplDetails.subList(surplusCount.intValue(),
						emplDetails.size());
				List<String> overSubscribedEmplList = overSubscribed.stream()
						.map(EmployeeSummaryEntity::getEnterpriseId).collect(Collectors.toList());
				bcEmployeeRepository.updateStatus(parentBcEntity.getParentBusinessCaseNumber(), overSubscribedEmplList,
						"O", modifiedBy);
			}
		} else {
			/*
			 * child BC overSubscribed implementation
			 */
			BusinessCaseEntity childBcEntity = associateBcRepository.findByChildBusinessCaseNumber(bcId);
			Long surplusCount = Long.parseLong(childBcEntity.getSurplusCount());
			if (volunteerCount > surplusCount) {
				Set<String> eidList = employeeList.stream()
						.filter(e -> e.getSeveranceStatus().equals(AssociateBusinessCaseConstant.VOLUNTEER_STATUS_V)
								|| e.getSeveranceStatus().equals(AssociateBusinessCaseConstant.VOLUNTEER_STATUS_O))
						.map(BcEmployeeEntity::getEnterpriseId).collect(Collectors.toSet());
				List<EmployeeSummaryEntity> emplDetails = getEmployeeDetails(eidList);
				List<EmployeeSummaryEntity> overSubscribed = emplDetails.subList(surplusCount.intValue(),
						emplDetails.size());
				List<String> overSubscribedEmplList = overSubscribed.stream()
						.map(EmployeeSummaryEntity::getEnterpriseId).collect(Collectors.toList());
				bcEmployeeRepository.updateStatus(childBcEntity.getPsBusinessCaseNumber(), overSubscribedEmplList, "O",
						modifiedBy);
			}

		}
		LOGGER.info("Inside VolunteerManagementServiceImpl class volunteerEmpl() method  end");
		return "Severance Status Was Updated Successfully.";
	}

	@Override
	public String scheduleNotification(VolunteerNotificationRq volunteerNotificationRq, String loggedInUser) {

		LOGGER.info("Inside VolunteerManagementServiceImpl class sendNotification() method start");

		List<BcEmployeeEntity> employeeList = new ArrayList<>();
		List<String> eidList = new ArrayList<>();
		Map<String, List<String>> groupByBc = null;
		// send notification based on volunteer filter
		LOGGER.info(
				"Inside VolunteerManagementServiceImpl class sendNotification() method send notification based on volunteer filter");
		if (volunteerNotificationRq.getVolunteerManagementFilter() != null && volunteerNotificationRq.isSelectedAll()) {
			VolunteerBcResponse volunteerListResponse = searchVolunteerBc(
					volunteerNotificationRq.getVolunteerManagementFilter(), 1, 10000);
			if (volunteerListResponse != null && volunteerListResponse.getVolunteerBusinessCaseList() != null) {
				if (!CollectionUtils.isEmpty(volunteerNotificationRq.getExclusionBusinesscases())) {
					employeeList = bcEmployeeRepository.getEmplByBcIdExcludingInactiveEmpls(
							volunteerListResponse.getVolunteerBusinessCaseList().stream()
									.filter(e -> !StringUtils.equalsAnyIgnoreCase(e.getPsBusinessCaseNumber(),
											volunteerNotificationRq.getExclusionBusinesscases().toArray(String[]::new)))
									.map(VolunteerBusinessCase::getPsBusinessCaseNumber).collect(Collectors.toList()));
				} else {
					employeeList = bcEmployeeRepository.getEmplByBcIdExcludingInactiveEmpls(
							volunteerListResponse.getVolunteerBusinessCaseList().stream()
									.map(VolunteerBusinessCase::getPsBusinessCaseNumber).collect(Collectors.toList()));

				}
			}
		} else if (CollectionUtils.isNotEmpty(volunteerNotificationRq.getBcIds())
				&& volunteerNotificationRq.isSelectedAll()) {
			LOGGER.info(
					"Inside VolunteerManagementServiceImpl class sendNotification() method send notification based on SelectAll Employeelevel list");
			employeeList = repo.getEmployeeList(volunteerNotificationRq);

		}
		// send notification based on businesscase list
		else if (CollectionUtils.isNotEmpty(volunteerNotificationRq.getBcIds())) {
			LOGGER.info(
					"Inside VolunteerManagementServiceImpl class sheduleNotification() method shedule notification based on businesscase list");
			employeeList = bcEmployeeRepository.getEmplByBcIdExcludingInactiveEmpls(volunteerNotificationRq.getBcIds());
			if (!CollectionUtils.isEmpty(volunteerNotificationRq.getExclusionEnterprisesIds())) {
				eidList = employeeList.stream()
						.filter(e -> !StringUtils.equalsAnyIgnoreCase(e.getEnterpriseId(),
								volunteerNotificationRq.getExclusionEnterprisesIds().toArray(String[]::new)))
						.map(BcEmployeeEntity::getEnterpriseId).collect(Collectors.toList());
			} else {
				eidList = employeeList.stream().map(BcEmployeeEntity::getEnterpriseId).collect(Collectors.toList());
			}
		} else {
			groupByBc = volunteerNotificationRq.getVolunteerManagementRq().stream()
					.collect(Collectors.groupingBy(VolunteerManagementRq::getBcId,
							Collectors.mapping(VolunteerManagementRq::getEid, Collectors.toList())));
			for (Map.Entry<String, List<String>> mapElement : groupByBc.entrySet()) {
				employeeList
						.addAll(bcEmployeeRepository.getEmplByBcIdAndEids(mapElement.getKey(), mapElement.getValue()));
				eidList.addAll(mapElement.getValue());
			}

		}
		if (CollectionUtils.isEmpty(employeeList)) {
			return null;
		}
		String loginUserName = businessCaseAuditHelper.getDisplayName(loggedInUser);
		String newOfferNotification = volunteerNotificationRq.getOfferNotification() != null ?
				volunteerNotificationRq.getOfferNotification().format(auditDateFormat) : null;

        ExecutorService executorService = Executors.newFixedThreadPool(5);
		if (volunteerNotificationRq.getOfferNotification() != null) {
			employeeList.forEach(e -> {
				executorService.submit(() -> {
					e.setScheduledOfferDate(volunteerNotificationRq.getOfferNotification());
					e.setLastModifiedBy(loggedInUser);
					e.setScheduledNotificationFlg(true);

					BcEmployeeNoteAuditEntity employeeAuditNoteEntity = BcEmployeeNoteAuditEntity.builder()
							.businessCaseNo(e.getBusinessCaseEntity() != null ? e.getBusinessCaseEntity().getPsBusinessCaseNumber()
									: e.getParentBusinessCaseEntity().getParentBusinessCaseNumber()).enterpriseId( e.getEnterpriseId())
							.createdUpdatedByTimestamp(LocalDateTime.now(ZoneOffset.UTC)).createdUpdatedByEid(loggedInUser)
							.createdUpdatedBy(loginUserName).notes("Schedule Offer Notification is set to Yes. Schedule Offer Notification Date is set to "+ newOfferNotification).build();
					bcEmployeeNoteRepository.save(employeeAuditNoteEntity);
				});

			});
			executorService.shutdown();
			try {
				executorService.awaitTermination(1, TimeUnit.MINUTES);
			} catch (InterruptedException e) {
				e.printStackTrace();
			}
			bcEmployeeRepository.saveAll(employeeList);
			log.info("email status was updated for the Employees : {}", eidList);
			return "The Offer Email Notification has been successfully scheduled";

		} else {
			employeeList.forEach(e -> {
				executorService.submit(() -> {
					e.setScheduledOfferDate(volunteerNotificationRq.getOfferNotification());
					e.setLastModifiedBy(loggedInUser);
					e.setScheduledNotificationFlg(false);
					BcEmployeeNoteAuditEntity employeeAuditNoteEntity = BcEmployeeNoteAuditEntity.builder()
							.businessCaseNo(e.getBusinessCaseEntity() != null ? e.getBusinessCaseEntity().getPsBusinessCaseNumber()
									: e.getParentBusinessCaseEntity().getParentBusinessCaseNumber()).enterpriseId( e.getEnterpriseId())
							.createdUpdatedByTimestamp(LocalDateTime.now(ZoneOffset.UTC)).createdUpdatedByEid(loggedInUser)
							.createdUpdatedBy(loginUserName).notes("Schedule Offer Notification is set to No.").build();
					bcEmployeeNoteRepository.save(employeeAuditNoteEntity);
				});
			});
			executorService.shutdown();
			try {
				executorService.awaitTermination(1, TimeUnit.MINUTES);
			} catch (InterruptedException e) {
				e.printStackTrace();
			}
			bcEmployeeRepository.saveAll(employeeList);
			log.info("email status was updated for the Employees : {}", eidList);
			return "The Offer Email Notification has been successfully cancelled";
		}
	}

