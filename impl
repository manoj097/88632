	private void updateVolunteerStatus(VolunteerNotificationRq volunteerNotificationRq, String loggedInUser,
			boolean isVolunteerAccepted, final String modifiedBy) {
		LOGGER.info("Inside VolunteerManagementServiceImpl class updateVolunteerStatus() method start");
		Map<String, List<String>> groupByBc = null;
		long startTime1 = System.currentTimeMillis();
		// update volunteer based on volunteer filter
		LOGGER.info(
				"Inside VolunteerManagementServiceImpl class updateVolunteerStatus() method update volunteer based on volunteer filter");
		if (volunteerNotificationRq.isSelectedAll()) {
			volunteerNotificationRq.getVolunteerManagementFilter().setSort("seniorityDate");
			volunteerNotificationRq.getVolunteerManagementFilter().setOrder("desc");
			VolunteerListResponse volunteerListResponse = searchEmployees(
					volunteerNotificationRq.getVolunteerManagementFilter());
			if (volunteerListResponse != null && volunteerListResponse.getVolunteerList() != null) {
				if (!CollectionUtils.isEmpty(volunteerNotificationRq.getExclusionEnterprisesIds())) {
					groupByBc = volunteerListResponse.getVolunteerList().stream()
							.filter(e -> !StringUtils.equalsAnyIgnoreCase(e.getEnterpriseId(),
									volunteerNotificationRq.getExclusionEnterprisesIds().toArray(String[]::new)))
							.collect(Collectors.groupingBy(VolunteerList::getBusinessCaseNoPc,
									Collectors.mapping(VolunteerList::getEnterpriseId, Collectors.toList())));
				} else {
					groupByBc = volunteerListResponse.getVolunteerList().stream()
							.collect(Collectors.groupingBy(VolunteerList::getBusinessCaseNoPc,
									Collectors.mapping(VolunteerList::getEnterpriseId, Collectors.toList())));
				}
			}
		}
		// update volunteer based on employee list
		else {
			LOGGER.info(
					"Inside VolunteerManagementServiceImpl class updateVolunteerStatus() method update volunteer based on employee list");
			groupByBc = volunteerNotificationRq.getVolunteerManagementRq().stream()
					.collect(Collectors.groupingBy(VolunteerManagementRq::getBcId,
							Collectors.mapping(VolunteerManagementRq::getEid, Collectors.toList())));
		}
		long endTime1 = System.currentTimeMillis();
		log.info("selectAll took time of " + (endTime1 - startTime1) + " ms");
		long startTime = System.currentTimeMillis();
		List<BcEmployeeEntityForVolunteerManagement> bcEmployeeEntities = new ArrayList<>();
		groupByBc.forEach((k, v) -> {
			bcEmployeeEntities.addAll(bcEmployeeForVolunteerManagementRepository.getEmplByBcIdAndEidsV2(k, v));
			// bcEmployeeRepository.updateStatus(k, v, sevStatus, modifiedBy);
		});
		Map<BcEmployeeEntityForVolunteerManagement, List<EmployeeAuditRequest>> employeeAuditMap = new HashMap<>();

		bcEmployeeEntities.forEach(e -> {
			String sevStatus = null;
			if (StringUtils.equalsAnyIgnoreCase(e.getSeveranceStatus(), "O", "OA", "OD")) {
				if (isVolunteerAccepted) {
					sevStatus = AssociateBusinessCaseConstant.VOLUNTEER_STATUS_OA;
				} else {
					sevStatus = AssociateBusinessCaseConstant.VOLUNTEER_STATUS_OD;
				}
			} else {
				if (isVolunteerAccepted) {
					sevStatus = AssociateBusinessCaseConstant.VOLUNTEER_STATUS_VA;
				} else {
					sevStatus = AssociateBusinessCaseConstant.VOLUNTEER_STATUS_VD;
				}
			}
			List<EmployeeAuditRequest> employeeAuditList = new ArrayList<>();
			if (!StringUtils.equalsIgnoreCase(e.getSeveranceStatus(), sevStatus)) {
				employeeAuditList.add(EmployeeAuditRequest.builder().fieldName("Severance Status")
						.oldValue(e.getSeveranceStatus() == null ? null : e.getSeveranceStatus())
						.newValue(sevStatus == null ? null : sevStatus).build());
			}
			
			  if (StringUtils.equalsAnyIgnoreCase(sevStatus, 
					AssociateBusinessCaseConstant.VOLUNTEER_STATUS_VA,
					AssociateBusinessCaseConstant.VOLUNTEER_STATUS_OA,
					AssociateBusinessCaseConstant.VOLUNTEER_STATUS_VD,
					AssociateBusinessCaseConstant.VOLUNTEER_STATUS_OD) && (e.getEmployeePortalAccess() != null && !e.getEmployeePortalAccess())) {
				e.setEmployeePortalAccess(true);
				employeeAuditList.add(EmployeeAuditRequest.builder().fieldName("Employee Portal").oldValue(null)
						.newValue("Enabled").build());
			}
			e.setLastModifiedBy(modifiedBy);
			e.setSeveranceStatus(sevStatus);
			e.setOperation("UPDATE");
			e.setLastUpdatedDate(LocalDateTime.now());
			employeeAuditMap.put(e, employeeAuditList);

		});
		LOGGER.info("Inside VolunteerManagementServiceImpl class updateVolunteerStatus() method end");
		businessCaseAuditHelper.persistVolunteerEmployeeAudit(loggedInUser, employeeAuditMap);
		bcEmployeeForVolunteerManagementRepository.saveAll(bcEmployeeEntities);
		long endTime = System.currentTimeMillis();
		log.info("update took time of " + (endTime - startTime) + " ms");
	}

    private List<String> normalizeSeveranceStatus(VolunteerManagementFilter volunteerFilter) {
        if (volunteerFilter == null || CollectionUtils.isEmpty(volunteerFilter.getSeveranceStatus())) {
            return Collections.emptyList();
        }
        List<String> codes = volunteerFilter.getSeveranceStatus().stream()
                .filter(StringUtils::isNotBlank)
                .map(v -> StringUtils.substringBefore(v, " - ").trim())
                .filter(code -> StringUtils.equalsAny(code,
                        AssociateBusinessCaseConstant.VOLUNTEER_STATUS_V,
                        AssociateBusinessCaseConstant.VOLUNTEER_STATUS_VA,
                        AssociateBusinessCaseConstant.VOLUNTEER_STATUS_VD,
                        AssociateBusinessCaseConstant.VOLUNTEER_STATUS_O,
                        AssociateBusinessCaseConstant.VOLUNTEER_STATUS_OA,
                        AssociateBusinessCaseConstant.VOLUNTEER_STATUS_OD))
                .distinct().collect(Collectors.toList());
        volunteerFilter.setSeveranceStatus(codes);
        return codes;
    }


    private List<BcEmployeeEntity> getEmployeesBySelectAllFilter(VolunteerNotificationRq volunteerNotificationRq) {
        VolunteerManagementFilter filter = volunteerNotificationRq.getVolunteerManagementFilter();
        List<String> statusCodes = normalizeSeveranceStatus(filter);

        VolunteerBcResponse volunteerBcResponse = searchVolunteerBc(filter, 1, 10000);
        List<BcEmployeeEntity> employeeList = new ArrayList<>();
        if (volunteerBcResponse != null && CollectionUtils.isNotEmpty(volunteerBcResponse.getVolunteerBusinessCaseList())) {
            List<String> bcNumbers = volunteerBcResponse.getVolunteerBusinessCaseList().stream()
                    .filter(bc -> CollectionUtils.isEmpty(volunteerNotificationRq.getExclusionBusinesscases())
                            || !StringUtils.equalsAnyIgnoreCase(bc.getPsBusinessCaseNumber(),
                                    volunteerNotificationRq.getExclusionBusinesscases().toArray(String[]::new)))
                    .map(VolunteerBusinessCase::getPsBusinessCaseNumber).collect(Collectors.toList());
            if (CollectionUtils.isNotEmpty(bcNumbers)) {
                employeeList = bcEmployeeRepository.getEmplByBcIdExcludingInactiveEmpls(bcNumbers);
            }
        }

        if (CollectionUtils.isNotEmpty(statusCodes)) {
            employeeList = employeeList.stream().filter(e -> statusCodes.contains(e.getSeveranceStatus()))
                    .collect(Collectors.toList());
        }

        if (CollectionUtils.isNotEmpty(filter.getUnion())) {
            employeeList = employeeList.stream()
                    .filter(e -> filter.getUnion().contains(e.getUnionLocal()))
                    .collect(Collectors.toList());
        }

        if (CollectionUtils.isNotEmpty(filter.getCba())) {
            employeeList = employeeList.stream()
                    .filter(e -> filter.getCba().contains(e.getCollectiveAgreementDescription()))
                    .collect(Collectors.toList());
        }
        if (StringUtils.isNotBlank(filter.getEmpIdOrName())) {
            String empIdOrName = filter.getEmpIdOrName();
            employeeList = employeeList.stream()
                    .filter(e -> StringUtils.containsIgnoreCase(e.getEnterpriseId(), empIdOrName)
                            || StringUtils.containsIgnoreCase(
                                    StringUtils.trimToEmpty(e.getLegalLastName()) + ", "
                                            + StringUtils.trimToEmpty(e.getLegalFirstName()),
                                    empIdOrName))
                    .collect(Collectors.toList());
        }
        return employeeList;
    }

