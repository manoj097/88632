					break;
				case AssociateBusinessCaseConstant.VOLUNTEER_STATUS_CODE_OA:
					status.add(AssociateBusinessCaseConstant.VOLUNTEER_STATUS_OA);
					break;
				case AssociateBusinessCaseConstant.VOLUNTEER_STATUS_CODE_OD:
					status.add(AssociateBusinessCaseConstant.VOLUNTEER_STATUS_OD);
					break;
				default:
