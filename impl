	@Override
	public VolunteerBcResponse searchVolunteerBc(VolunteerManagementFilter volunteerFilter, int pageNumber,
			int pageSize) {

		LOGGER.info("Inside VolunteerManagementServiceImpl class searchVolunteerBc() method start");
		List<VolunteerBusinessCase> volunteerBusinessCaseList = new ArrayList<>();

		// get parent BC numbers based on filter criteria
		List<Long> bcId = new ArrayList<>();
		List<Long> bcIdParent = new ArrayList<>();

		List<ParentBusinessCaseEntity> parentBcEntityLists = parentBusinessCaseRepository
				.findAll(volunteerManagementSpecification.getVolunteerParentBcFilter(volunteerFilter));

        if(parentBcEntityLists.isEmpty()){
            parentBcEntityLists = parentBusinessCaseRepository
                    .findAll(volunteerManagementSpecification.getDirectVolunteerParentBcFilter(volunteerFilter));
        }

		volunteerFilter.setParentBusinessCaseNumber(parentBcEntityLists.stream()
				.map(ParentBusinessCaseEntity::getParentBusinessCaseNumber).collect(Collectors.toList()));

		if (CollectionUtils.isNotEmpty(volunteerFilter.getParentBusinessCaseNumber())) {
			List<BusinessCaseEntity> bcEntityListforParent = associateBcRepository
					.findAll(volunteerManagementSpecification.getVolunteerBcFilterForParent(volunteerFilter));

			List<ChildParentEntity> InParent = new ArrayList<>();
			bcEntityListforParent.forEach(e -> {
				InParent.addAll(e.getChildParentList());
			});
			InParent.forEach(p -> {
				if (p.getParentStatus().equalsIgnoreCase("Active")) {
					bcId.add(p.getBusinessCaseEntity().getBusinessCaseNumber());
					bcIdParent.add(p.getBusinessCaseEntity().getBusinessCaseNumber());
				}
			});
		}

		/*
		 * get all BCs
		 */
		LOGGER.info(
				"Inside VolunteerManagementServiceImpl class searchVolunteerBc() method get all BCs from associateBcRepository");
		List<BusinessCaseEntity> bcEntityList = associateBcRepository
				.findAll(volunteerManagementSpecification.getVolunteerBcFilter(volunteerFilter));

		/*
		 * get child BC which is not added to parent
		 */
		LOGGER.info(
				"Inside VolunteerManagementServiceImpl class searchVolunteerBc() method get child BC which is not added to parent");
		List<ChildParentEntity> notInParent = new ArrayList<>();
		bcEntityList.forEach(e -> {
			notInParent.addAll(e.getChildParentList());
		});
		notInParent.forEach(p -> {
			if (p.getParentStatus().equalsIgnoreCase("Active")) {
				bcId.add(p.getBusinessCaseEntity().getBusinessCaseNumber());
			}
		});
		volunteerFilter.setBcNumber(bcId.stream().distinct().collect(Collectors.toList()));
		List<BusinessCaseEntity> childBcEntityList = associateBcRepository
				.findAll(volunteerManagementSpecification.getVolunteerBcFilter(volunteerFilter));
		/*
		 * get parent Bc
		 */
		LOGGER.info("Inside VolunteerManagementServiceImpl class searchVolunteerBc() method getting parent Bc");
		List<ParentBusinessCaseEntity> parentBcEntityList = new ArrayList<>();
		List<ChildParentEntity> childParentEntityList = new ArrayList<>();
		if (CollectionUtils.isNotEmpty(bcIdParent)) {
			List<Long> parentId = associateBcRepository.getParentBc(volunteerFilter.getBusinessCaseNumber());
			childParentEntityList = childParentRepository
					.findAll(volunteerManagementSpecification.getChildParentFilter(bcIdParent, parentId));
			childParentEntityList.forEach(cp -> {
				if (cp.getParentStatus().equalsIgnoreCase("Active")) {
					parentBcEntityList.add(cp.getParentBusinessCaseEntity());
				}
				if (cp.getBusinessCaseEntity().getStatus().equalsIgnoreCase("Active")
						&& !cp.getParentStatus().equalsIgnoreCase("Active") && !volunteerFilter.getBcNumber()
								.contains(cp.getBusinessCaseEntity().getBusinessCaseNumber())) {
					childBcEntityList.add(cp.getBusinessCaseEntity());
				}
			});
		}

		if (CollectionUtils.isNotEmpty(parentBcEntityLists) && (CollectionUtils.isNotEmpty(volunteerFilter.getUnion())
				|| CollectionUtils.isNotEmpty(volunteerFilter.getCba()))) {
			Set<Long> alreadyIncludedParentIds = parentBcEntityList.stream()
					.map(ParentBusinessCaseEntity::getParentId).collect(Collectors.toSet());
			for (ParentBusinessCaseEntity candidate : parentBcEntityLists) {
				if (alreadyIncludedParentIds.contains(candidate.getParentId())) {
					continue;
				}
				boolean hasDirectMatch = CollectionUtils.isNotEmpty(candidate.getBcEmployeeEntityList())
						&& candidate.getBcEmployeeEntityList().stream()
								.anyMatch(emp -> (CollectionUtils.isEmpty(volunteerFilter.getUnion())
										|| volunteerFilter.getUnion().contains(emp.getUnionLocal()))
										&& (CollectionUtils.isEmpty(volunteerFilter.getCba())
												|| volunteerFilter.getCba()
														.contains(emp.getCollectiveAgreementDescription())));
				if (hasDirectMatch) {
					parentBcEntityList.add(candidate);
					alreadyIncludedParentIds.add(candidate.getParentId());
				}
			}
		}
		/*
		 * Set volunteer List for Active child BC which was not added to Active Parent
		 * BC
		 */
		LOGGER.info(
				"Inside VolunteerManagementServiceImpl class searchVolunteerBc() method Set volunteer List for Active child BC which was not added to Active Parent Bc");
		if (CollectionUtils.isNotEmpty(childBcEntityList)) {
			List<BusinessCaseEntity> childBcEntityListRs = childBcEntityList.stream().distinct()
					.collect(Collectors.toList());
			childBcEntityListRs.forEach(child -> {
				Long volunteerCount = child.getBcEmployeeEntityList().stream().filter(employee -> employee
						.getSeveranceStatus() != null
						&& (employee.getSeveranceStatus().equals(AssociateBusinessCaseConstant.VOLUNTEER_STATUS_V)
								|| employee.getSeveranceStatus()
										.equals(AssociateBusinessCaseConstant.VOLUNTEER_STATUS_VA)
								|| employee.getSeveranceStatus()
										.equals(AssociateBusinessCaseConstant.VOLUNTEER_STATUS_VD)))
						.count();
				Long overSubcribedCount = child.getBcEmployeeEntityList().stream()
						.filter(employee -> employee.getSeveranceStatus() != null && StringUtils.equalsAny(
								employee.getSeveranceStatus(), AssociateBusinessCaseConstant.VOLUNTEER_STATUS_O,
								AssociateBusinessCaseConstant.VOLUNTEER_STATUS_OA,
								AssociateBusinessCaseConstant.VOLUNTEER_STATUS_OD))
						.count();
				Long nonVolunteerCount = child.getBcEmployeeEntityList().stream()
						.filter(employee -> employee.getSeveranceStatus() != null && (employee.getSeveranceStatus()
								.equals(AssociateBusinessCaseConstant.VOLUNTEER_STATUS_E)
								|| employee.getSeveranceStatus()
										.equals(AssociateBusinessCaseConstant.VOLUNTEER_STATUS_D)))
						.count();
				volunteerBusinessCaseList.add(VolunteerBusinessCase.builder()
						.businessCaseNumber(child.getBusinessCaseNumber())
						.psBusinessCaseNumber(child.getPsBusinessCaseNumber()).parentBusinessCase(false)
						.surplusJobTitle(new HashSet<>(Arrays.asList(child.getJobTitle()))).faa(child.getFaa())
						.cba(child.getBargainingUnit()).union(child.getUnion())
						.startDateOfVolunteerPeriod(child.getStartDateOfVolunteerPeriod())
						.endOfVolunteerPeriod(child.getEndOfVolunteerPeriod())
						.universe(
								associateBcRepository.getUniverCountByBusinessCaseNumber(child.getBusinessCaseNumber()))
						.surplusCount(Long.parseLong(child.getSurplusCount())).volunteerCount(volunteerCount)
						.nonVolunteerCount(nonVolunteerCount).oversubscribedCount(overSubcribedCount)
						.terminationDate(child.getTerminationDate()).build());
			});
		}
		/*
		 * Group by parent BC
		 */
		LOGGER.info("Inside VolunteerManagementServiceImpl class searchVolunteerBc() method Grouping by parent BC");
		if (CollectionUtils.isNotEmpty(parentBcEntityList)) {
			Map<ParentBusinessCaseEntity, List<BusinessCaseEntity>> groupByBcEntity = childParentEntityList.stream()
					.collect(Collectors.groupingBy(ChildParentEntity::getParentBusinessCaseEntity,
							Collectors.mapping(ChildParentEntity::getBusinessCaseEntity, Collectors.toList())));

			/*
			 * Set Volunteer for Active Parent BC
			 */
			LOGGER.info(
					"Inside VolunteerManagementServiceImpl class searchEmployees() getting  Setting Volunteer for Active Parent BC");
			parentBcEntityList.stream().distinct().forEach(parent -> {
				List<BusinessCaseEntity> childBcs = groupByBcEntity.getOrDefault(parent, Collections.emptyList());
				List<BcEmployeeEntity> bcEmpl = bcEmployeeRepository
						.getEmplByBcId(Arrays.asList(parent.getParentBusinessCaseNumber()));
				Long volunteerCount = bcEmpl.stream().filter(employee -> employee.getSeveranceStatus() != null
						&& (employee.getSeveranceStatus().equals(AssociateBusinessCaseConstant.VOLUNTEER_STATUS_V)
								|| employee.getSeveranceStatus()
										.equals(AssociateBusinessCaseConstant.VOLUNTEER_STATUS_VA)
								|| employee.getSeveranceStatus()
										.equals(AssociateBusinessCaseConstant.VOLUNTEER_STATUS_VD)))
						.count();
				Long overSubcribedCount = bcEmpl.stream()
						.filter(employee -> employee.getSeveranceStatus() != null && StringUtils.equalsAny(
								employee.getSeveranceStatus(), AssociateBusinessCaseConstant.VOLUNTEER_STATUS_O,
								AssociateBusinessCaseConstant.VOLUNTEER_STATUS_OA,
								AssociateBusinessCaseConstant.VOLUNTEER_STATUS_OD))
						.count();
				Long nonVolunteerCount = bcEmpl.stream().filter(employee -> employee.getSeveranceStatus() != null
						&& (employee.getSeveranceStatus().equals(AssociateBusinessCaseConstant.VOLUNTEER_STATUS_E)
								|| employee.getSeveranceStatus()
										.equals(AssociateBusinessCaseConstant.VOLUNTEER_STATUS_D)))
						.count();
				// calculating surpluse count of parent business case case
				Long surplusCount = null;
				List<String> surplusList = childBcs.stream().map(BusinessCaseEntity::getSurplusCount)
						.collect(Collectors.toList());
				Long surplus = (long) 0;
				for (String s : surplusList) {
					if(!StringUtils.isBlank(s))
					surplus += Long.parseLong(s);
				}
//				if (parent.getSurplusCount() == null) {
//					surplusCount = surplus;
//				} else {
//					surplusCount = Long.parseLong(parent.getSurplusCount());
//				} 
				//CPS-79321 - surplus count issue in dashboard
				surplusCount = surplus;

				volunteerBusinessCaseList.add(VolunteerBusinessCase.builder()
						.psBusinessCaseNumber(parent.getParentBusinessCaseNumber()).parentBusinessCase(true)
						.surplusJobTitle(
								childBcs.stream().map(BusinessCaseEntity::getJobTitle).collect(Collectors.toSet()))
						.faa(childBcs.isEmpty() ? null : childBcs.get(0).getFaa())
						.cba(childBcs.isEmpty() ? null : childBcs.get(0).getBargainingUnit())
						.union(childBcs.isEmpty() ? null : childBcs.get(0).getUnion())
						.startDateOfVolunteerPeriod(parent.getStartDateOfVolunteerPeriod())
						.endOfVolunteerPeriod(parent.getEndDateOfVolunteerPeriod())
						.universe(parentBusinessCaseRepository.getUniverseCount(parent.getParentId()))
						.terminationDate(childBcs.isEmpty() ? null : childBcs.get(0).getTerminationDate())
						.surplusCount(surplusCount)
						.volunteerCount(volunteerCount).nonVolunteerCount(nonVolunteerCount)
						.oversubscribedCount(overSubcribedCount).build());
			});
		}

		// IVD-86420 Separating the unions for UI to consume
//		Set<String> unionList = volunteerBusinessCaseList.parallelStream()
//				.filter(employee -> !StringUtils.isEmpty(employee.getUnion())).map(VolunteerBusinessCase::getUnion)
//				.collect(Collectors.toSet());
		Set<String> unionList = new TreeSet<>();
		for (VolunteerBusinessCase bc : volunteerBusinessCaseList) {
			if (!StringUtils.isEmpty(bc.getUnion())) {
				String mergedUnion = bc.getUnion();
				String[] splitUnion = mergedUnion.split(",");
				for (String union : splitUnion) {
					unionList.add(union);
				}
			}
		}
		Set<String> cbaList = volunteerBusinessCaseList.parallelStream()
				.filter(employee -> !StringUtils.isEmpty(employee.getCba())).map(VolunteerBusinessCase::getCba)
				.collect(Collectors.toSet());

		/*
		 * Pagination for Volunteer List
		 */
		LOGGER.info(
				"Inside VolunteerManagementServiceImpl class searchVolunteerBc() method Pagination for Volunteer List");
		Pageable pageable = PageRequest.of(pageNumber - 1, pageSize);
		int start = (int) pageable.getOffset();
		int end = Math.min((start + pageable.getPageSize()), volunteerBusinessCaseList.size());
		if ("surplusJobTitle".equals(volunteerFilter.getSort())) {
			VolunteerBusinessCaseJobTitleComparator jobTitleComparator = new VolunteerBusinessCaseJobTitleComparator();
			Collections.sort(volunteerBusinessCaseList, jobTitleComparator);
		} else if ("faa".equals(volunteerFilter.getSort())) {
			VolunteerBusinessCaseFaaComparator faaComparator = new VolunteerBusinessCaseFaaComparator();
			Collections.sort(volunteerBusinessCaseList, faaComparator);
		} else
			volunteerBusinessCaseList.sort(sortingOptions.get(volunteerFilter.getSort()));
		if ("desc".equals(volunteerFilter.getOrder()))
			Collections.reverse(volunteerBusinessCaseList);

		Page<VolunteerBusinessCase> volunteerListRs = new PageImpl<>(volunteerBusinessCaseList.subList(start, end),
				pageable, volunteerBusinessCaseList.size());
		/*
		 * Set universe count details
		 */
		LOGGER.info(
				"Inside VolunteerManagementServiceImpl class searchVolunteerBc() method Setting universe count details");
		List<Long> surplus = new ArrayList<>();
		List<Long> universe = new ArrayList<>();
		List<Long> volunteer = new ArrayList<>();
		List<Long> overSubcribed = new ArrayList<>();
		volunteerBusinessCaseList.forEach(v -> {
			surplus.add(v.getSurplusCount() == null ? 0L : v.getSurplusCount());
			universe.add(v.getUniverse() == null ? 0L : v.getUniverse());
			volunteer.add(v.getVolunteerCount() == null ? 0L : v.getVolunteerCount());
			overSubcribed.add(v.getOversubscribedCount() == null ? 0L : v.getOversubscribedCount());
		});
		UniverseDetailsCount universeDetails = UniverseDetailsCount.builder()
				.surplusCount(surplus.stream().mapToLong(Long::intValue).sum())
				.universeCount(universe.stream().mapToLong(Long::intValue).sum())
				.volunteerCount(volunteer.stream().mapToLong(Long::intValue).sum())
				.totalOverSubscribe(overSubcribed.stream().mapToLong(Long::intValue).sum()).build();
		/*
		 * return Response
		 */
		LOGGER.info("Inside VolunteerManagementServiceImpl class searchVolunteerBc() method end");
		return VolunteerBcResponse.builder().volunteerBusinessCaseList(volunteerListRs.getContent())
				.numberOfElements(volunteerListRs.getNumberOfElements())
				.currentPageNumber(volunteerListRs.getPageable().getPageNumber() + 1)
				.totalElements(volunteerListRs.getTotalElements()).pageSize(volunteerListRs.getPageable().getPageSize())
				.totalPages(volunteerListRs.getTotalPages()).universeDetails(universeDetails)
				.volunteerFilters(VolunteerFilterRs.builder().cba(cbaList).union(unionList)
						// IVD-84280--CBA & Union filter
						// .cba(volunteerListRs.stream().map(VolunteerBusinessCase::getCba).collect(Collectors.toSet()))
						// .union(volunteerListRs.stream().map(VolunteerBusinessCase::getUnion)
						// .collect(Collectors.toSet()))
						.build())
				.build();
	}

