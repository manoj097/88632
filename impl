	@Override
	public LookUpResponse getBcNo(int limit, int offSet, String bcno) {
		LOGGER.info("Inside VolunteerManagementServiceImpl class getBcNo() method start");
		List<String> activeChildBc = associateBcRepository.getAllActiveBcList();
		List<String> activeParentBc = parentBusinessCaseRepository.getAllActiveBcList();
		if (bcno != null && !bcno.isEmpty()) {
			activeChildBc = associateBcRepository.getAllActiveBcList(bcno);
			activeParentBc = parentBusinessCaseRepository.getAllActiveBcList(bcno);
		}
		List<String> bcList = new ArrayList<>();
		bcList.addAll(activeChildBc);
		bcList.addAll(activeParentBc);
		Pageable pageable = PageRequest.of(offSet, limit);
		int start = pageable.getPageNumber();
		int end = Math.min((start + pageable.getPageSize()), bcList.size());
		Page<String> response = new PageImpl<>(bcList.subList(start, end), pageable, bcList.size());
		LOGGER.info("Inside VolunteerManagementServiceImpl class getBcNo() method end");
		return LookUpResponse.builder().options(response.toList()).totalElements((long) bcList.size())
				.numberOfElements(response.getNumberOfElements()).build();
	}

	@Override
	public LookUpResponse getPlanCodes(String role, int limit, int offSet, String planCode) {
		LOGGER.info("Inside VolunteerManagementServiceImpl class getPlanCodes() method start");
		Page<PlanCodeEntity> planCodeEntityList = null;
		List<Long> planCodeList = associateBcRepository.getAllActiveBcs();
		if (planCodeList == null) {
			return null;
		}
		Pageable page = PageRequest.of(offSet, limit);
		if (planCode == null) {
			planCodeEntityList = planCodeRepository.findAllByPlanCodeId(planCodeList, page);
		} else {
			planCodeEntityList = planCodeRepository.findAllByPlanCode(planCodeList, planCode, page);
		}

		Map<String, String> planCodes = new TreeMap<>();
		planCodeEntityList.forEach(p -> {
			planCodes.put(p.getPlanCode(), p.getPlanCodeDesc());
		});
		LOGGER.info("Inside VolunteerManagementServiceImpl class getPlanCodes() method end");
		return LookUpResponse.builder().planCode(planCodes).totalElements(planCodeEntityList.getTotalElements())
				.numberOfElements(planCodeEntityList.getNumberOfElements()).build();
	}

